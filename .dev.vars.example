# Local Wrangler secrets (wrangler dev). Do not commit.
# Production: npx wrangler secret put SHOPIFY_CLIENT_ID
#             npx wrangler secret put SHOPIFY_CLIENT_SECRET

SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional overrides; defaults come from wrangler.toml [vars]
